
DOCTYPE html>
<html lang="sw">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>BetMakini Support</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(180deg, #0a0f0d 0%, #0d1512 100%);
            color: #fff;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #1a6b3d 0%, #0f4d2a 100%);
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }

        .bot-avatar {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #22c55e, #16a34a);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            border: 2px solid rgba(255,255,255,0.2);
        }

        .bot-info h1 { font-size: 16px; font-weight: 600; }
        .bot-info p {
            font-size: 12px;
            color: rgba(255,255,255,0.8);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .online-dot {
            width: 8px;
            height: 8px;
            background: #22c55e;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .chat-container {
            flex: 1;
            overflow-y: auto;
            padding: 20px 15px 100px 15px;
            scroll-behavior: smooth;
        }

        .message {
            max-width: 85%;
            margin-bottom: 14px;
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .message.bot { margin-right: auto; }
        .message.user { margin-left: auto; }

        .message-content {
            padding: 12px 16px;
            border-radius: 18px;
            font-size: 14px;
            line-height: 1.6;
        }

        .message.bot .message-content {
            background: #1a2420;
            border-bottom-left-radius: 4px;
            color: #e5e7eb;
        }

        .message.user .message-content {
            background: linear-gradient(135deg, #1a6b3d, #0f4d2a);
            border-bottom-right-radius: 4px;
        }

        .message-time {
            font-size: 10px;
            color: #6b7280;
            margin-top: 4px;
            padding: 0 6px;
        }

        .message.user .message-time { text-align: right; }

        .typing-indicator {
            display: flex;
            gap: 5px;
            padding: 16px 20px;
            background: #1a2420;
            border-radius: 18px;
            border-bottom-left-radius: 4px;
            width: fit-content;
            margin-bottom: 14px;
        }

        .typing-indicator span {
            width: 8px;
            height: 8px;
            background: #22c55e;
            border-radius: 50%;
            animation: typing 1.4s infinite;
        }

        .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
        .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }

        @keyframes typing {
            0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
            30% { transform: translateY(-8px); opacity: 1; }
        }

        .menu-options {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 14px;
        }

        .menu-btn {
            background: #1a2420;
            border: 1px solid #2d3b35;
            color: #fff;
            padding: 14px 18px;
            border-radius: 14px;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: 'Inter', sans-serif;
            display: flex;
            align-items: center;
            gap: 12px;
            text-align: left;
        }

        .menu-btn:hover {
            background: #22c55e;
            border-color: #22c55e;
            transform: translateX(5px);
        }

        .menu-icon {
            width: 36px;
            height: 36px;
            background: rgba(34, 197, 94, 0.15);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .highlight { color: #22c55e; font-weight: 600; }

        .whatsapp-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: linear-gradient(135deg, #25d366, #128c7e);
            color: #fff;
            padding: 14px 24px;
            border-radius: 30px;
            font-size: 15px;
            font-weight: 600;
            text-decoration: none;
            margin-top: 12px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .whatsapp-btn:hover {
            transform: scale(1.03);
            box-shadow: 0 6px 25px rgba(37, 211, 102, 0.4);
        }

        .payment-box {
            background: linear-gradient(135deg, #1a2420, #0d1512);
            border: 2px solid #22c55e;
            border-radius: 16px;
            padding: 20px;
            margin: 12px 0;
            text-align: center;
        }

        .payment-box h4 {
            color: #22c55e;
            font-size: 14px;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .payment-box .number {
            font-size: 28px;
            font-weight: 700;
            color: #fff;
            letter-spacing: 3px;
            margin: 10px 0;
        }

        .payment-box .name {
            font-size: 14px;
            color: #9ca3af;
            margin-top: 8px;
        }

        .name-input-box { margin-top: 12px; }

        .name-input {
            width: 100%;
            background: #1a2420;
            border: 1px solid #2d3b35;
            border-radius: 12px;
            padding: 14px 16px;
            color: #fff;
            font-size: 15px;
            font-family: 'Inter', sans-serif;
            outline: none;
            margin-bottom: 10px;
        }

        .name-input:focus { border-color: #22c55e; }

        .name-submit {
            width: 100%;
            background: linear-gradient(135deg, #22c55e, #16a34a);
            border: none;
            padding: 14px;
            border-radius: 12px;
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
        }

        .info-box {
            background: #1a2420;
            border-radius: 14px;
            padding: 16px;
            margin: 12px 0;
            line-height: 1.7;
        }

        .info-box p { color: #d1d5db; font-size: 14px; }

        .back-btn {
            background: transparent;
            border: 1px solid #2d3b35;
            color: #9ca3af;
            padding: 10px 16px;
            border-radius: 10px;
            font-size: 13px;
            cursor: pointer;
            margin-top: 12px;
            font-family: 'Inter', sans-serif;
        }

        .back-btn:hover { border-color: #22c55e; color: #22c55e; }
    </style>
</head>
<body>
    <div class="header">
        <div class="bot-avatar">👩‍💼</div>
        <div class="bot-info">
            <h1>BetMakini Support</h1>
            <p><span class="online-dot"></span> Ryhana - Online</p>
        </div>
    </div>

    <div class="chat-container" id="chatContainer"></div>

    <script>
        // ==================== DATA ====================
        const BOT_DATA = {
            payment: {
                method: 'AIRTEL Money',
                number: '134898066',
                name: 'NEEMA SWAI'
            },
            whatsapp: '+255612921476'
        };

        let userName = localStorage.getItem('betmakini_username') || null;

        function getTime() {
            const now = new Date();
            return now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
        }

        function addMessage(content, isBot = true, isHTML = false) {
            const chat = document.getElementById('chatContainer');
            const msg = document.createElement('div');
            msg.className = `message ${isBot ? 'bot' : 'user'}`;
            
            const contentDiv = document.createElement('div');
            contentDiv.className = 'message-content';
            if (isHTML) contentDiv.innerHTML = content;
            else contentDiv.textContent = content;
            
            const timeDiv = document.createElement('div');
            timeDiv.className = 'message-time';
            timeDiv.textContent = getTime();
            
            msg.appendChild(contentDiv);
            msg.appendChild(timeDiv);
            chat.appendChild(msg);
            chat.scrollTop = chat.scrollHeight;
        }

        function showTyping() {
            const chat = document.getElementById('chatContainer');
            const typing = document.createElement('div');
            typing.className = 'typing-indicator';
            typing.id = 'typing';
            typing.innerHTML = '<span></span><span></span><span></span>';
            chat.appendChild(typing);
            chat.scrollTop = chat.scrollHeight;
        }

        function hideTyping() {
            const t = document.getElementById('typing');
            if (t) t.remove();
        }

        function botReply(content, isHTML = false, delay = 700) {
            showTyping();
            setTimeout(() => {
                hideTyping();
                addMessage(content, true, isHTML);
            }, delay);
        }

        function startChat() {
            if (userName) {
                botReply(`Habari <span class="highlight">${userName}</span>! 👋\n\nNi mimi Ryhana, mtoa huduma wa BetMakini.\n\nNikusaidie nini leo?`, true, 400);
                setTimeout(() => showMainMenu(), 1200);
            } else {
                botReply(`Habari! 👋\n\nMimi ni <span class="highlight">Ryhana</span>, mtoa huduma wa BetMakini.\n\nKabla hatujaendelea, tafadhali niambie jina lako:`, true, 400);
                setTimeout(() => showNameInput(), 1200);
            }
        }

        function showNameInput() {
            const html = `
                <div class="name-input-box">
                    <input type="text" class="name-input" id="nameInput" placeholder="Andika jina lako...">
                    <button class="name-submit" onclick="submitName()">Endelea</button>
                </div>
            `;
            addMessage(html, true, true);
            
            setTimeout(() => {
                const input = document.getElementById('nameInput');
                if (input) {
                    input.focus();
                    input.addEventListener('keypress', (e) => {
                        if (e.key === 'Enter') submitName();
                    });
                }
            }, 100);
        }

        function submitName() {
            const input = document.getElementById('nameInput');
            if (!input) return;
            
            const name = input.value.trim();
            if (!name) return;
            
            userName = name;
            localStorage.setItem('betmakini_username', name);
            
            addMessage(name, false);
            
            botReply(`Asante <span class="highlight">${name}</span>! 🎉\n\nNafurahi kukujua. Sasa nikusaidie nini?`, true, 500);
            setTimeout(() => showMainMenu(), 1300);
        }

        function showMainMenu() {
            const html = `
                <div class="menu-options">
                    <button class="menu-btn" onclick="handleMenu('payment')">
                        <span class="menu-icon">💳</span>
                        <span>Namna ya Kulipia Access Code</span>
                    </button>
                    <button class="menu-btn" onclick="handleMenu('about')">
                        <span class="menu-icon">ℹ️</span>
                        <span>BetMakini ni Nini?</span>
                    </button>
                    <a href="https://wa.me/${BOT_DATA.whatsapp.replace(/[^0-9]/g, '')}?text=Habari,%20mimi%20ni%20${encodeURIComponent(userName || 'Mteja')}%20nahitaji%20msaada" class="whatsapp-btn" target="_blank">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                        Wasiliana na Ryhana
                    </a>
                </div>
            `;
            addMessage(html, true, true);
        }

        function handleMenu(option) {
            if (option === 'payment') {
                addMessage('Namna ya Kulipia', false);
                showPayment();
            } else if (option === 'about') {
                addMessage('BetMakini ni Nini?', false);
                showAbout();
            }
        }

        function showPayment() {
            const html = `
                <div class="payment-box">
                    <h4>💳 AIRTEL Money</h4>
                    <div class="number">${BOT_DATA.payment.number}</div>
                    <div class="name">Jina: <strong>${BOT_DATA.payment.name}</strong></div>
                </div>
                <div class="info-box">
                    <p>📌 <strong>Jinsi ya Kulipia:</strong></p>
                    <p>1. Nenda AIRTEL Money</p>
                    <p>2. Chagua "Tuma Pesa"</p>
                    <p>3. Weka namba: <span class="highlight">${BOT_DATA.payment.number}</span></p>
                    <p>4. Weka kiasi kulingana na bei ya Tipster</p>
                    <p>5. Tuma screenshot WhatsApp</p>
                    <p><br>✅ Utapokea <span class="highlight">Access Code</span> moja kwa moja baada ya kuthibitisha malipo!</p>
                </div>
                <a href="https://wa.me/${BOT_DATA.whatsapp.replace(/[^0-9]/g, '')}?text=Habari%20Ryhana,%20mimi%20ni%20${encodeURIComponent(userName || 'Mteja')}.%20Nimelipia%20Access%20Code." class="whatsapp-btn" target="_blank">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    Tuma Screenshot WhatsApp
                </a>
                <button class="back-btn" onclick="goBack()">← Rudi Nyuma</button>
            `;
            botReply(html, true);
        }

        function showAbout() {
            const html = `
                <div class="info-box">
                    <p><span class="highlight">BetMakini</span> ni jukwaa la kuaminika la betting tips Tanzania! 🇹🇿</p>
                    <p><br>🎯 <strong>Tunachofanya:</strong></p>
                    <p>• Tunakusanya Tipsters bora wa Tanzania</p>
                    <p>• Kila Tipster ana accuracy yake iliyothibitishwa</p>
                    <p>• Unapata predictions za uhakika kila siku</p>
                    <p><br>💡 <strong>Jinsi Inavyofanya Kazi:</strong></p>
                    <p>1. Lipia kupata Access Code</p>
                    <p>2. Weka code kwenye App</p>
                    <p>3. Pata VIP predictions masaa 8</p>
                    <p><br>✅ Tumesaidia watu wengi kushinda!</p>
                </div>
                <button class="back-btn" onclick="goBack()">← Rudi Nyuma</button>
            `;
            botReply(html, true);
        }

        function goBack() {
            addMessage('Rudi Nyuma', false);
            botReply(`Sawa <span class="highlight">${userName}</span>, nikusaidie nini kingine?`, true, 400);
            setTimeout(() => showMainMenu(), 1100);
        }

        // Start
        window.onload = () => setTimeout(startChat, 300);
    </script>
</body>
</html>


